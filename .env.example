# Google Apps Script web app URL (see google-apps-script/README in the main README)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Must match SECRET in Code.gs, so only this site can write to your sheet
GOOGLE_SCRIPT_SECRET=change-me-to-a-long-random-string
# WhatsApp community invite link shown after registration
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/XXXXXXXXXXXX
